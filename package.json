{
  "name": "front-buscador-of",
  "version": "1.1.0",
  "description": "Buscador de órdenes TSI",
  "author": "TSI Ingeniería de Imagen",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build --base-href ./",
    "test": "ng test",
    "watch": "ng build --watch --configuration development",
    "electron": "electron ./main.js",                             
    "electron-dev": "ng build --base-href ./ && electron ./main.js", 
    "dist": "npm run build && electron-builder --win --x64",      
    "package-win": "npm run build && electron-builder --win nsis" 
  },
  "dependencies": {
    "@angular/animations": "^16.2.10",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "cors": "^2.8.5",
    "electron-log": "^5.4.1",
    "electron-updater": "^6.1.1",
    "express": "^5.1.0",
    "ngx-toastr": "^17.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.7",
    "@angular/cli": "^16.2.7",
    "@angular/compiler-cli": "^16.2.0",
    "@types/jasmine": "~4.3.0",
    "electron": "^27.0.2",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.1.3"
  },
  "build": {
    "appId": "com.tsi.buscadorof",
    "productName": "BuscadorDeOrdenes",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "api-buscador/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "BuscadorDeOrdenes-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}


